---
layout: layout.njk
---
<h1 class="title">Our Products</h1>
<p>Explore our gaming PCs and accessories.</p>
{% set products = [
  {
    "name": "Gaming PC",
    "price": 1499,
    "description": "High-performance gaming desktop."
  },
  {
    "name": "Mechanical Keyboard",
    "price": 129,
    "description": "Responsive mechanical keyboard for gaming."
  },
  {
    "name": "Gaming Headset",
    "price": 89,
    "description": "Comfortable headset with immersive sound."
  }
  ] %}
  <div class="columns is-multiline">
    {% for product in products %}
    <div class="column is-one-third">
      <div class="card">
        <div class="card-content">
          <h2 class="title is-4">{{ product.name }}</h2>
          <p class="subtitle is-6">€{{ product.price }}</p>
          <p>{{ product.description }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>